# Copy to .env and fill in. .env is gitignored.
#
#   cp .env.example .env
#   python3 deploy/deploy.py --check


# --- Dropbox app (App Console -> your app) -----------------------------------
# Permissions tab: enable account_info.read, files.metadata.read, files.content.read
# Settings tab: add <WP_URL>/oauth/dropbox/callback as redirect URI.
# deploy.py renders these into the plugin's sew-dnp-config.php (never committed).
App_key=<dropbox app key>
App_secret=<dropbox app secret>

# Optional: a short-lived token generated in the App Console, for testing the
# picker without the OAuth flow. Enable it on the plugin's settings page.
#ACCESS_TOKEN_FOR_TESTING=


# --- WordPress + FTP credentials -------------------------------------------------
# EITHER (a) put them here ...
WP_URL=https://example.com
WP_USER=<wordpress user>
# MUST be an Application Password (wp-admin -> Users -> Profile), not the login
# password; spaces in it are fine. Used only to activate the plugin over REST.
WP_PWD=<application password>

# Host or IP; an ftp:// prefix is stripped, a :port suffix is honoured.
FTP_IP=ftp://<host or ip>
FTP_USER=<ftp user>
FTP_PWD=<ftp password>
# Hint for the document root; the directory containing wp-load.php is detected.
FTP_FOLDER=public_html

# ... OR (b) borrow them from another repo's .env (a directory or a .env file).
# Keys set above win; SUB_ENV_PATH only fills in what is missing.
#SUB_ENV_PATH=~/Documents/git/music_blog

# Optional: page fetched after the upload to detect a fatal error (default WP_URL/).
#HEALTH_URL=https://example.com/?tag=konzert
